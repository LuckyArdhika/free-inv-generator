:80 {
    # Set webroot directory
    root * /usr/share/caddy

    # Enable compression
    encode gzip zstd

    # Handle requests with subpath prefix (/free-invoice-generator/*)
    handle_path /free-invoice-generator/* {
        root * /usr/share/caddy
        file_server
        try_files {path} {path}/ /index.html
    }

    # Handle direct requests without prefix
    handle {
        root * /usr/share/caddy
        file_server
        try_files {path} {path}/ /index.html
    }

    # Cache control: HTML files should not be aggressively cached
    @html {
        path *.html / /free-invoice-generator/
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    # Cache control: Content-hashed static assets can be cached immutably
    @immutable {
        path /_astro/* /free-invoice-generator/_astro/*
    }
    header @immutable Cache-Control "public, max-age=31536000, immutable"
}