<!-- CLIENT SIDE JAVASCRIPT CONTROLLER -->
<script is:inline>
  // Wait for the DOM to load
  document.addEventListener('DOMContentLoaded', () => {
    
    // Core state selectors
    const selectors = {
      invNumber: { input: 'input-inv-number', preview: 'preview-inv-number' },
      status: { input: 'input-status', preview: 'preview-status-badge' },
      currency: { input: 'input-currency', preview: 'preview-subtotal' },
      customCurrency: 'input-custom-currency',
      customCurrencyContainer: 'custom-currency-container',
      dateIssue: { input: 'input-date-issue', preview: 'preview-date-issue' },
      dateDue: { input: 'input-date-due', preview: 'preview-date-due' },
      fromCompany: { input: 'input-from-company', preview: 'preview-from-company' },
      fromName: { input: 'input-from-name', preview: 'preview-from-name' },
      fromEmail: { input: 'input-from-email', preview: 'preview-from-address' },
      fromAddress: { input: 'input-from-address', preview: 'preview-from-address' },
      toCompany: { input: 'input-to-company', preview: 'preview-to-company' },
      toName: { input: 'input-to-name', preview: 'preview-to-name' },
      toEmail: { input: 'input-to-email', preview: 'preview-to-email' },
      toAddress: { input: 'input-to-address', preview: 'preview-to-address' },
      taxRate: 'input-tax',
      discountRate: 'input-discount',
      shippingCost: 'input-shipping',
      notes: { input: 'input-notes', preview: 'preview-notes' },
      logoInput: 'input-logo',
      logoUploadBtn: 'btn-upload-logo',
      logoRemoveBtn: 'btn-remove-logo',
      logoPreview: 'logo-preview',
      logoPlaceholder: 'logo-placeholder',
      logoSheetContainer: 'preview-logo-container',
      logoSheetImg: 'preview-logo',
      lineItemsContainer: 'editor-line-items-container',
      addLineItemBtn: 'btn-add-item',
      printBtn: 'btn-print-invoice',
      resetBtn: 'btn-reset',
      // Invoice storage and management selectors
      btnSaveInvoice: 'btn-save-invoice',
      btnQuickSave: 'btn-quick-save',
      btnNewInvoice: 'btn-new-invoice',
      btnOpenSavedModal: 'btn-open-saved-modal',
      btnCloseSavedModal: 'btn-close-saved-modal',
      btnModalClose: 'btn-modal-close',
      btnModalNewInvoice: 'btn-modal-new-invoice',
      btnClearAllSaved: 'btn-clear-all-saved',
      btnUnlinkInvoice: 'btn-unlink-invoice',
      savedSearchInput: 'saved-search-input',
      savedInvoicesModal: 'saved-invoices-modal'
    };

    // Storage keys configuration
    const STORAGE_KEYS = {
      SAVED_INVOICES: 'quinvy_saved_invoices',
      ACTIVE_ID: 'quinvy_active_invoice_id',
      DRAFT: 'quinvy_invoice_draft',
      TEMPLATE: 'quinvy_invoice_template'
    };

    // Default template data (starts completely empty)
    const defaults = {
      invNumber: '',
      status: 'Pending',
      currency: '$',
      customCurrency: '',
      dateIssue: '',
      dateDue: '',
      fromCompany: '',
      fromName: '',
      fromEmail: '',
      fromAddress: '',
      toCompany: '',
      toName: '',
      toEmail: '',
      toAddress: '',
      taxRate: 0,
      discountRate: 0,
      shippingCost: 0,
      notes: '',
      logo: '',
      accentColor: '#048c5f',
      items: []
    };

    // Helper functions for DOM bindings
    const getEl = (id) => document.getElementById(id);

    // Escape special HTML characters
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Format relative time helper
    function timeAgo(timestamp) {
      if (!timestamp) return 'Just now';
      const diff = Math.floor((Date.now() - timestamp) / 1000);
      if (diff < 60) return 'Just now';
      if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
      if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
      const d = new Date(timestamp);
      return d.toLocaleDateString();
    }

    // Status visual styles configuration
    function getStatusBadgeConfig(status) {
      switch (status) {
        case 'Paid':
          return {
            classes: 'bg-emerald-50 text-emerald-700 border-emerald-300',
            dotClass: 'bg-emerald-500',
            label: 'Paid'
          };
        case 'Overdue':
          return {
            classes: 'bg-rose-50 text-rose-700 border-rose-300',
            dotClass: 'bg-rose-500',
            label: 'Overdue'
          };
        case 'Draft':
          return {
            classes: 'bg-gray-100 text-gray-700 border-gray-300',
            dotClass: 'bg-gray-400',
            label: 'Draft'
          };
        case 'Pending':
        default:
          return {
            classes: 'bg-amber-50 text-amber-700 border-amber-300',
            dotClass: 'bg-amber-400',
            label: 'Pending'
          };
      }
    }

    // Update status badge UI in toolbar and live preview sheet
    function updateStatusUI(status) {
      const currentStatus = status || getEl(selectors.status.input)?.value || 'Pending';
      const config = getStatusBadgeConfig(currentStatus);

      // Update active toolbar badge
      const activeBadge = getEl('active-inv-status-badge');
      if (activeBadge) {
        activeBadge.className = `px-2 py-0.5 rounded-full text-xxs font-extrabold uppercase border ${config.classes}`;
        activeBadge.textContent = config.label;
      }

      // Update live preview sheet badge
      const previewBadge = getEl(selectors.status.preview);
      if (previewBadge) {
        previewBadge.className = `px-2.5 py-0.5 rounded-full text-xxs font-extrabold uppercase tracking-wider border ${config.classes}`;
        previewBadge.textContent = config.label;
      }
    }
    
    // Core calculation and preview rendering functions
    function formatMoney(amount, symbol) {
      const val = parseFloat(amount) || 0;
      return `${symbol}${val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    // Get current currency symbol
    function getCurrencySymbol() {
      const select = getEl(selectors.currency.input);
      if (select && select.value === 'custom') {
        return getEl(selectors.customCurrency)?.value || '';
      }
      return select ? select.value : '$';
    }

    // Calculate totals and render corresponding fields
    function calculateInvoice() {
      const symbol = getCurrencySymbol();
      let subtotal = 0;
      
      // Update all editor currency symbols
      document.querySelectorAll('.currency-symbol-label').forEach(el => {
        el.textContent = symbol;
      });
      
      // Calculate each line item sum
      const rows = getEl(selectors.lineItemsContainer)?.children || [];
      const previewBody = getEl('preview-table-body');
      if (previewBody) previewBody.innerHTML = '';

      Array.from(rows).forEach((row) => {
        const desc = row.querySelector('.item-desc')?.value || '';
        const qty = parseFloat(row.querySelector('.item-qty')?.value) || 0;
        const rate = parseFloat(row.querySelector('.item-rate')?.value) || 0;
        const amount = qty * rate;
        subtotal += amount;

        // Update read-only amount input in form
        const amountSpan = row.querySelector('.item-amount-span');
        if (amountSpan) amountSpan.textContent = formatMoney(amount, symbol);

        // Append to preview table
        if (previewBody) {
          const tr = document.createElement('tr');
          tr.className = 'border-b border-gray-100';
          tr.innerHTML = `
            <td class="py-3 text-gray-900 font-medium whitespace-pre-wrap">${escapeHtml(desc) || 'Untitled Item'}</td>
            <td class="py-3 text-right text-gray-600">${qty}</td>
            <td class="py-3 text-right text-gray-600">${formatMoney(rate, symbol)}</td>
            <td class="py-3 text-right text-gray-900 font-bold">${formatMoney(amount, symbol)}</td>
          `;
          previewBody.appendChild(tr);
        }
      });

      // Subtotal display
      const subtotalEl = getEl('preview-subtotal');
      if (subtotalEl) subtotalEl.textContent = formatMoney(subtotal, symbol);

      // Tax calculation
      const taxRate = parseFloat(getEl(selectors.taxRate)?.value) || 0;
      const taxAmount = (subtotal * taxRate) / 100;
      const taxRow = getEl('preview-tax-row');
      if (taxRow) {
        if (taxRate > 0) {
          taxRow.classList.remove('hidden');
          getEl('preview-tax-label').textContent = `Tax (${taxRate}%)`;
          getEl('preview-tax-value').textContent = formatMoney(taxAmount, symbol);
        } else {
          taxRow.classList.add('hidden');
        }
      }

      // Discount calculation
      const discountRate = parseFloat(getEl(selectors.discountRate)?.value) || 0;
      const discountAmount = (subtotal * discountRate) / 100;
      const discountRow = getEl('preview-discount-row');
      if (discountRow) {
        if (discountRate > 0) {
          discountRow.classList.remove('hidden');
          getEl('preview-discount-label').textContent = `Discount (-${discountRate}%)`;
          getEl('preview-discount-value').textContent = `-${formatMoney(discountAmount, symbol)}`;
        } else {
          discountRow.classList.add('hidden');
        }
      }

      // Shipping cost
      const shipping = parseFloat(getEl(selectors.shippingCost)?.value) || 0;
      const shippingRow = getEl('preview-shipping-row');
      if (shippingRow) {
        if (shipping > 0) {
          shippingRow.classList.remove('hidden');
          getEl('preview-shipping-value').textContent = formatMoney(shipping, symbol);
        } else {
          shippingRow.classList.add('hidden');
        }
      }

      // Grand total
      const total = subtotal + taxAmount - discountAmount + shipping;
      const totalEl = getEl('preview-total');
      if (totalEl) totalEl.textContent = formatMoney(total, symbol);
    }

    // Add a line item to the form editor
    function addLineItem(desc = '', qty = 1, rate = 0) {
      const container = getEl(selectors.lineItemsContainer);
      if (!container) return;
      const rowId = `item-row-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
      const symbol = getCurrencySymbol();
      
      const itemRow = document.createElement('div');
      itemRow.className = 'grid grid-cols-12 gap-3 items-center border border-gray-100 p-3 rounded-lg relative group bg-gray-50/50';
      itemRow.id = rowId;

      itemRow.innerHTML = `
        <div class="col-span-12 sm:col-span-6">
          <label class="block text-xxs font-bold uppercase text-gray-400 mb-0.5 sm:hidden">Description</label>
          <input type="text" class="item-desc w-full bg-white border border-gray-200 rounded px-2.5 py-1.5 text-xs focus:outline-none focus:border-primary" placeholder="Description" value="${escapeHtml(desc)}" />
        </div>
        <div class="col-span-4 sm:col-span-2">
          <label class="block text-xxs font-bold uppercase text-gray-400 mb-0.5 sm:hidden">Qty</label>
          <input type="number" class="item-qty w-full bg-white border border-gray-200 rounded px-2.5 py-1.5 text-xs text-right focus:outline-none focus:border-primary" placeholder="0" min="0" step="any" value="${qty}" />
        </div>
        <div class="col-span-4 sm:col-span-2">
          <label class="block text-xxs font-bold uppercase text-gray-400 mb-0.5 sm:hidden">Rate</label>
          <div class="relative flex items-center">
            <span class="absolute left-2.5 text-xxs font-bold text-gray-400 currency-symbol-label">${symbol}</span>
            <input type="number" class="item-rate w-full bg-white border border-gray-200 rounded pl-7 pr-2.5 py-1.5 text-xs text-right focus:outline-none focus:border-primary" placeholder="0.00" min="0" step="any" value="${rate}" />
          </div>
        </div>
        <div class="col-span-3 sm:col-span-2 text-right">
          <label class="block text-xxs font-bold uppercase text-gray-400 mb-0.5 sm:hidden">Amount</label>
          <span class="item-amount-span text-xs font-bold text-gray-900">0.00</span>
        </div>
        <button type="button" class="btn-delete-row absolute -right-2.5 -top-2.5 bg-red-100 hover:bg-red-200 text-red-600 rounded-full w-5 h-5 flex items-center justify-center text-xxs shadow opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer" title="Remove line item">
          &times;
        </button>
      `;

      // Set up individual line item triggers
      itemRow.querySelector('.item-desc')?.addEventListener('keyup', calculateInvoice);
      itemRow.querySelector('.item-qty')?.addEventListener('keyup', calculateInvoice);
      itemRow.querySelector('.item-qty')?.addEventListener('change', calculateInvoice);
      itemRow.querySelector('.item-rate')?.addEventListener('keyup', calculateInvoice);
      itemRow.querySelector('.item-rate')?.addEventListener('change', calculateInvoice);
      
      // Delete event handler
      itemRow.querySelector('.btn-delete-row')?.addEventListener('click', () => {
        itemRow.remove();
        calculateInvoice();
        saveDraft();
      });

      container.appendChild(itemRow);
      calculateInvoice();
    }

    // File uploading process
    function setupLogoHandling() {
      const fileInput = getEl(selectors.logoInput);
      const uploadBtn = getEl(selectors.logoUploadBtn);
      const removeBtn = getEl(selectors.logoRemoveBtn);
      if (!fileInput || !uploadBtn) return;

      uploadBtn.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        if (file.size > 1.5 * 1024 * 1024) {
          alert("Logo size exceeds 1.5MB. Please upload a smaller image file.");
          return;
        }

        const reader = new FileReader();
        reader.onload = (event) => {
          const base64 = event.target.result;
          displayLogo(base64);
          saveDraft();
        };
        reader.readAsDataURL(file);
      });

      removeBtn?.addEventListener('click', () => {
        displayLogo('');
        saveDraft();
      });
    }

    // Logo display state toggle
    function displayLogo(base64) {
      const previewImg = getEl(selectors.logoPreview);
      const placeholder = getEl(selectors.logoPlaceholder);
      const removeBtn = getEl(selectors.logoRemoveBtn);
      const sheetContainer = getEl(selectors.logoSheetContainer);
      const sheetImg = getEl(selectors.logoSheetImg);

      if (base64 && base64.startsWith('data:')) {
        if (previewImg) {
          previewImg.src = base64;
          previewImg.classList.remove('hidden');
        }
        if (placeholder) placeholder.classList.add('hidden');
        if (removeBtn) removeBtn.classList.remove('hidden');

        if (sheetImg) sheetImg.src = base64;
        if (sheetContainer) {
          sheetContainer.classList.remove('hidden');
          sheetContainer.classList.add('flex');
        }
      } else {
        if (previewImg) {
          previewImg.removeAttribute('src');
          previewImg.classList.add('hidden');
        }
        if (placeholder) placeholder.classList.remove('hidden');
        if (removeBtn) removeBtn.classList.add('hidden');

        if (sheetImg) sheetImg.removeAttribute('src');
        if (sheetContainer) {
          sheetContainer.classList.add('hidden');
          sheetContainer.classList.remove('flex');
        }
        const fileIn = getEl(selectors.logoInput);
        if (fileIn) fileIn.value = '';
      }
    }

    // Extract current complete state of the invoice
    function getInvoiceState() {
      const state = {
        invNumber: getEl(selectors.invNumber.input)?.value || '',
        status: getEl(selectors.status.input)?.value || 'Pending',
        currency: getEl(selectors.currency.input)?.value || '$',
        customCurrency: getEl(selectors.customCurrency)?.value || '',
        dateIssue: getEl(selectors.dateIssue.input)?.value || '',
        dateDue: getEl(selectors.dateDue.input)?.value || '',
        fromCompany: getEl(selectors.fromCompany.input)?.value || '',
        fromName: getEl(selectors.fromName.input)?.value || '',
        fromEmail: getEl(selectors.fromEmail.input)?.value || '',
        fromAddress: getEl(selectors.fromAddress.input)?.value || '',
        toCompany: getEl(selectors.toCompany.input)?.value || '',
        toName: getEl(selectors.toName.input)?.value || '',
        toEmail: getEl(selectors.toEmail.input)?.value || '',
        toAddress: getEl(selectors.toAddress.input)?.value || '',
        taxRate: parseFloat(getEl(selectors.taxRate)?.value) || 0,
        discountRate: parseFloat(getEl(selectors.discountRate)?.value) || 0,
        shippingCost: parseFloat(getEl(selectors.shippingCost)?.value) || 0,
        notes: getEl(selectors.notes.input)?.value || '',
        logo: getEl(selectors.logoPreview)?.getAttribute('src') || '',
        accentColor: getEl('input-accent-color')?.value || '#048c5f',
        template: localStorage.getItem(STORAGE_KEYS.TEMPLATE) || 'minimal',
        items: []
      };

      const rows = getEl(selectors.lineItemsContainer)?.children || [];
      Array.from(rows).forEach(row => {
        state.items.push({
          desc: row.querySelector('.item-desc')?.value || '',
          qty: parseFloat(row.querySelector('.item-qty')?.value) || 0,
          rate: parseFloat(row.querySelector('.item-rate')?.value) || 0
        });
      });

      return state;
    }

    // Extract summary metadata for listing saved invoices
    function getCurrentInvoiceSummary() {
      const invNumber = getEl(selectors.invNumber.input)?.value.trim() || 'Untitled Invoice';
      const status = getEl(selectors.status.input)?.value || 'Pending';
      const toCompany = getEl(selectors.toCompany.input)?.value.trim() || '';
      const toName = getEl(selectors.toName.input)?.value.trim() || '';
      const clientName = toCompany || toName || 'Unspecified Client';
      const fromCompany = getEl(selectors.fromCompany.input)?.value.trim() || '';
      const fromName = getEl(selectors.fromName.input)?.value.trim() || '';
      const senderName = fromCompany || fromName || '';
      const dateIssue = getEl(selectors.dateIssue.input)?.value || '';
      const dateDue = getEl(selectors.dateDue.input)?.value || '';
      const symbol = getCurrencySymbol();
      
      const rows = getEl(selectors.lineItemsContainer)?.children || [];
      let subtotal = 0;
      Array.from(rows).forEach(row => {
        const qty = parseFloat(row.querySelector('.item-qty')?.value) || 0;
        const rate = parseFloat(row.querySelector('.item-rate')?.value) || 0;
        subtotal += qty * rate;
      });

      const taxRate = parseFloat(getEl(selectors.taxRate)?.value) || 0;
      const taxAmount = (subtotal * taxRate) / 100;
      const discountRate = parseFloat(getEl(selectors.discountRate)?.value) || 0;
      const discountAmount = (subtotal * discountRate) / 100;
      const shipping = parseFloat(getEl(selectors.shippingCost)?.value) || 0;
      const total = subtotal + taxAmount - discountAmount + shipping;

      return {
        invNumber,
        status,
        clientName,
        senderName,
        dateIssue,
        dateDue,
        currency: symbol,
        total,
        totalFormatted: formatMoney(total, symbol),
        itemsCount: rows.length
      };
    }

    // Read saved invoices list from localStorage
    function getSavedInvoices() {
      try {
        const raw = localStorage.getItem(STORAGE_KEYS.SAVED_INVOICES);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        console.error('Failed reading saved invoices:', e);
        return [];
      }
    }

    // Persist saved invoices list to localStorage
    function saveInvoicesList(list) {
      try {
        localStorage.setItem(STORAGE_KEYS.SAVED_INVOICES, JSON.stringify(list));
      } catch (e) {
        console.error('Failed saving invoices list:', e);
      }
    }

    // Get active invoice ID being edited
    function getActiveInvoiceId() {
      return localStorage.getItem(STORAGE_KEYS.ACTIVE_ID) || null;
    }

    // Set active invoice ID
    function setActiveInvoiceId(id) {
      if (id) {
        localStorage.setItem(STORAGE_KEYS.ACTIVE_ID, id);
      } else {
        localStorage.removeItem(STORAGE_KEYS.ACTIVE_ID);
      }
    }

    // Toast notification display helper
    let toastTimeout = null;
    function showToast(message, isError = false) {
      const toast = getEl('invoice-toast');
      const msgEl = getEl('toast-message');
      const iconEl = getEl('toast-icon');
      if (!toast || !msgEl) return;

      msgEl.textContent = message;
      if (isError) {
        toast.classList.remove('bg-gray-900');
        toast.classList.add('bg-red-900');
        if (iconEl) iconEl.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>';
      } else {
        toast.classList.remove('bg-red-900');
        toast.classList.add('bg-gray-900');
        if (iconEl) iconEl.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>';
      }

      toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
      toast.classList.add('opacity-100', 'translate-y-0');

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 3000);
    }

    // Save working state in draft cache
    function saveDraft() {
      const state = getInvoiceState();
      try {
        localStorage.setItem(STORAGE_KEYS.DRAFT, JSON.stringify(state));
      } catch (e) {
        console.error('Failed saving draft:', e);
      }
      
      const activeId = getActiveInvoiceId();
      if (activeId) {
        const titleEl = getEl('active-inv-badge-title');
        const invNum = state.invNumber.trim() || 'Untitled Invoice';
        if (titleEl) titleEl.textContent = invNum;
        const lastSavedEl = getEl('active-inv-last-saved');
        if (lastSavedEl) lastSavedEl.textContent = 'Unsaved changes • Click Update';
      }
    }

    // Save or update invoice into localStorage
    function saveCurrentInvoice(forceNew = false) {
      const state = getInvoiceState();
      const summary = getCurrentInvoiceSummary();
      const savedInvoices = getSavedInvoices();
      let activeId = getActiveInvoiceId();
      const now = Date.now();

      const isExisting = !forceNew && activeId && savedInvoices.some(inv => inv.id === activeId);

      if (isExisting) {
        // Update existing invoice record
        const index = savedInvoices.findIndex(inv => inv.id === activeId);
        savedInvoices[index] = {
          ...savedInvoices[index],
          ...summary,
          updatedAt: now,
          data: state
        };
        saveInvoicesList(savedInvoices);
        showToast(`Invoice "${summary.invNumber}" updated!`);
      } else {
        // Create new invoice record
        const newId = `inv_${now}_${Math.random().toString(36).substring(2, 8)}`;
        const newRecord = {
          id: newId,
          ...summary,
          createdAt: now,
          updatedAt: now,
          data: state
        };
        savedInvoices.unshift(newRecord);
        saveInvoicesList(savedInvoices);
        setActiveInvoiceId(newId);
        showToast(`Invoice "${summary.invNumber}" saved!`);
      }

      // Also persist to current working draft
      localStorage.setItem(STORAGE_KEYS.DRAFT, JSON.stringify(state));
      updateToolbarUI();
    }

    // Update top toolbar and badge indicators
    function updateToolbarUI() {
      const activeId = getActiveInvoiceId();
      const savedInvoices = getSavedInvoices();
      const badgeEl = getEl('saved-invoices-count-badge');
      const modalCountEl = getEl('saved-modal-count-text');
      const titleEl = getEl('active-inv-badge-title');
      const lastSavedEl = getEl('active-inv-last-saved');
      const dotEl = getEl('status-indicator-dot');
      const unlinkBtn = getEl('btn-unlink-invoice');
      const saveBtnText = getEl('btn-save-text');
      const quickSaveText = getEl('btn-quick-save-text');

      if (badgeEl) badgeEl.textContent = String(savedInvoices.length);
      if (modalCountEl) modalCountEl.textContent = `${savedInvoices.length} invoice${savedInvoices.length === 1 ? '' : 's'}`;

      const activeInv = activeId ? savedInvoices.find(inv => inv.id === activeId) : null;

      if (activeInv) {
        if (titleEl) titleEl.textContent = activeInv.invNumber || 'Untitled Invoice';
        if (lastSavedEl) lastSavedEl.textContent = `Saved • Updated ${timeAgo(activeInv.updatedAt)}`;
        if (dotEl) {
          dotEl.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0';
        }
        if (unlinkBtn) unlinkBtn.classList.remove('hidden');
        if (saveBtnText) saveBtnText.textContent = 'Update Invoice';
        if (quickSaveText) quickSaveText.textContent = 'Update';
      } else {
        const currentNum = getEl(selectors.invNumber.input)?.value.trim();
        if (titleEl) titleEl.textContent = currentNum || 'New Draft';
        if (lastSavedEl) lastSavedEl.textContent = 'Unsaved in LocalStorage';
        if (dotEl) {
          dotEl.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 shrink-0';
        }
        if (unlinkBtn) unlinkBtn.classList.add('hidden');
        if (saveBtnText) saveBtnText.textContent = 'Save Invoice';
        if (quickSaveText) quickSaveText.textContent = 'Save';
      }

      // Sync status indicators
      updateStatusUI(getEl(selectors.status.input)?.value);
    }

    // Unlink active invoice so further edits save as a new invoice
    function unlinkActiveInvoice() {
      setActiveInvoiceId(null);
      updateToolbarUI();
      showToast('Unlinked from saved invoice. Further saves will create a new copy.');
    }

    // Load an invoice by ID into the editor form
    function loadInvoiceById(id) {
      const savedInvoices = getSavedInvoices();
      const target = savedInvoices.find(inv => inv.id === id);
      if (!target) return;

      setActiveInvoiceId(target.id);
      loadInvoiceData(target.data);
      closeSavedModal();
      updateToolbarUI();
      showToast(`Loaded invoice "${target.invNumber}"!`);
    }

    // Duplicate an invoice by ID
    function duplicateInvoiceById(id) {
      const savedInvoices = getSavedInvoices();
      const target = savedInvoices.find(inv => inv.id === id);
      if (!target) return;

      const now = Date.now();
      const newId = `inv_${now}_${Math.random().toString(36).substring(2, 8)}`;
      const clonedData = JSON.parse(JSON.stringify(target.data));
      const newNumber = target.invNumber ? `${target.invNumber} (Copy)` : 'INV-Copy';
      clonedData.invNumber = newNumber;

      const newRecord = {
        ...target,
        id: newId,
        invNumber: newNumber,
        createdAt: now,
        updatedAt: now,
        data: clonedData
      };

      savedInvoices.unshift(newRecord);
      saveInvoicesList(savedInvoices);

      loadInvoiceById(newId);
      showToast(`Duplicated as "${newNumber}"!`);
    }

    // Delete an invoice by ID
    function deleteInvoiceById(id) {
      const savedInvoices = getSavedInvoices();
      const target = savedInvoices.find(inv => inv.id === id);
      if (!target) return;

      const confirmed = confirm(`Are you sure you want to delete invoice "${target.invNumber}"? This cannot be undone.`);
      if (!confirmed) return;

      const updatedList = savedInvoices.filter(inv => inv.id !== id);
      saveInvoicesList(updatedList);

      if (getActiveInvoiceId() === id) {
        setActiveInvoiceId(null);
      }

      renderSavedInvoicesModal(getEl(selectors.savedSearchInput)?.value || '');
      updateToolbarUI();
      showToast(`Invoice "${target.invNumber}" deleted.`);
    }

    // Clear all saved invoices with confirmation
    function clearAllSavedInvoices() {
      const savedInvoices = getSavedInvoices();
      if (savedInvoices.length === 0) {
        alert('There are no saved invoices to clear.');
        return;
      }

      const confirmed = confirm(`Are you sure you want to permanently delete all ${savedInvoices.length} saved invoices? This cannot be undone.`);
      if (!confirmed) return;

      saveInvoicesList([]);
      setActiveInvoiceId(null);
      renderSavedInvoicesModal();
      updateToolbarUI();
      showToast('All saved invoices have been cleared.');
    }

    // Create a new blank invoice
    function createNewBlankInvoice() {
      const confirmed = confirm('Start a new blank invoice? Current unsaved edits will be cleared.');
      if (!confirmed) return;

      setActiveInvoiceId(null);
      localStorage.removeItem(STORAGE_KEYS.DRAFT);
      loadInvoiceData(defaults);
      closeSavedModal();
      updateToolbarUI();
      showToast('New blank invoice ready.');
    }

    // Active status filter state for saved modal
    let currentStatusFilter = 'all';

    // Render list inside Saved Invoices modal
    function renderSavedInvoicesModal(query = '') {
      const listEl = getEl('saved-invoices-list');
      const emptyEl = getEl('saved-invoices-empty');
      const countText = getEl('saved-modal-count-text');
      const savedInvoices = getSavedInvoices();
      const activeId = getActiveInvoiceId();

      const q = (query || '').toLowerCase().trim();
      const filtered = savedInvoices.filter(inv => {
        const invStatus = inv.status || inv.data?.status || 'Pending';
        if (currentStatusFilter !== 'all' && invStatus.toLowerCase() !== currentStatusFilter.toLowerCase()) {
          return false;
        }
        if (!q) return true;
        const invNum = (inv.invNumber || '').toLowerCase();
        const client = (inv.clientName || '').toLowerCase();
        const sender = (inv.senderName || '').toLowerCase();
        const date = (inv.dateIssue || '').toLowerCase();
        const statusText = invStatus.toLowerCase();
        return invNum.includes(q) || client.includes(q) || sender.includes(q) || date.includes(q) || statusText.includes(q);
      });

      if (countText) {
        countText.textContent = `${filtered.length} of ${savedInvoices.length} invoice${savedInvoices.length === 1 ? '' : 's'}`;
      }

      if (savedInvoices.length === 0) {
        if (listEl) listEl.innerHTML = '';
        if (emptyEl) {
          emptyEl.classList.remove('hidden');
          emptyEl.querySelector('p').textContent = 'No Saved Invoices Found';
        }
        return;
      }

      if (filtered.length === 0) {
        if (listEl) listEl.innerHTML = '';
        if (emptyEl) {
          emptyEl.classList.remove('hidden');
          emptyEl.querySelector('p').textContent = 'No matching invoices found.';
        }
        return;
      }

      if (emptyEl) emptyEl.classList.add('hidden');
      if (!listEl) return;

      listEl.innerHTML = filtered.map(inv => {
        const isActive = inv.id === activeId;
        const invStatus = inv.status || inv.data?.status || 'Pending';
        const statusConfig = getStatusBadgeConfig(invStatus);

        return `
          <div class="border ${isActive ? 'border-emerald-300 bg-emerald-50/40' : 'border-gray-200 bg-white'} rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:border-gray-300 transition shadow-xs">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <span class="font-extrabold text-sm text-gray-900">${escapeHtml(inv.invNumber || 'Untitled Invoice')}</span>
                <span class="px-2 py-0.5 rounded-full text-xxs font-extrabold uppercase border ${statusConfig.classes}">
                  ${escapeHtml(invStatus)}
                </span>
                ${isActive ? '<span class="bg-emerald-100 text-emerald-800 border border-emerald-300 text-xxs font-bold px-2 py-0.5 rounded-full flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Active in Editor</span>' : ''}
              </div>
              <div class="text-xs text-gray-500 space-y-0.5">
                <p><span class="font-medium text-gray-700">Client:</span> ${escapeHtml(inv.clientName || 'Unspecified')}</p>
                <p class="text-xxs text-gray-400">Date: ${inv.dateIssue || '-'} • ${inv.itemsCount || 0} item${inv.itemsCount === 1 ? '' : 's'} • Updated ${timeAgo(inv.updatedAt)}</p>
              </div>
            </div>
            
            <div class="flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-gray-100">
              <div class="text-right">
                <span class="text-xs text-gray-400 block sm:hidden">Total</span>
                <span class="font-extrabold text-sm sm:text-base text-gray-900">${escapeHtml(inv.totalFormatted)}</span>
              </div>
              
              <div class="flex items-center gap-1.5">
                <button 
                  type="button" 
                  class="btn-load-inv px-3 py-1.5 ${isActive ? 'bg-emerald-600 text-white' : 'bg-emerald-50 hover:bg-emerald-100 text-primary border border-emerald-200'} rounded-lg text-xs font-bold transition cursor-pointer" 
                  data-id="${inv.id}"
                >
                  ${isActive ? 'Editing' : 'Open'}
                </button>
                <button 
                  type="button" 
                  class="btn-duplicate-inv p-1.5 text-gray-500 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition cursor-pointer" 
                  data-id="${inv.id}" 
                  title="Duplicate this invoice"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                </button>
                <button 
                  type="button" 
                  class="btn-delete-inv p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition cursor-pointer" 
                  data-id="${inv.id}" 
                  title="Delete this invoice"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Attach event listeners to dynamic list buttons
      listEl.querySelectorAll('.btn-load-inv').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (id) loadInvoiceById(id);
        });
      });

      listEl.querySelectorAll('.btn-duplicate-inv').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (id) duplicateInvoiceById(id);
        });
      });

      listEl.querySelectorAll('.btn-delete-inv').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (id) deleteInvoiceById(id);
        });
      });
    }

    // Modal open and close handlers
    function openSavedModal() {
      const modal = getEl(selectors.savedInvoicesModal);
      if (!modal) return;
      currentStatusFilter = 'all';
      // Reset filter tabs active style
      document.querySelectorAll('#saved-status-filter-tabs .status-tab-btn').forEach(b => {
        if (b.getAttribute('data-status') === 'all') {
          b.className = 'status-tab-btn px-2.5 py-1 rounded-md font-bold transition cursor-pointer bg-white border border-gray-200 text-gray-800 shadow-2xs';
        } else {
          b.className = 'status-tab-btn px-2.5 py-1 rounded-md font-semibold transition cursor-pointer text-gray-500 hover:text-gray-900';
        }
      });
      modal.classList.remove('hidden');
      renderSavedInvoicesModal();
      const searchInput = getEl(selectors.savedSearchInput);
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
    }

    function closeSavedModal() {
      const modal = getEl(selectors.savedInvoicesModal);
      if (!modal) return;
      modal.classList.add('hidden');
    }

    // Loading data into the editor form
    function loadInvoiceData(customData = null) {
      let data = defaults;
      if (customData) {
        data = customData;
      } else {
        // First check if an active saved invoice was loaded
        const activeId = getActiveInvoiceId();
        const savedInvoices = getSavedInvoices();
        const activeInv = activeId ? savedInvoices.find(inv => inv.id === activeId) : null;

        if (activeInv && activeInv.data) {
          data = activeInv.data;
        } else {
          // Check cached draft
          const cached = localStorage.getItem(STORAGE_KEYS.DRAFT);
          if (cached) {
            try {
              data = JSON.parse(cached);
            } catch(e) {
              console.error("Failed parsing invoice draft cache.", e);
            }
          }
        }
      }

      // Populate form elements
      getEl(selectors.invNumber.input).value = data.invNumber || '';
      if (getEl(selectors.status.input)) {
        getEl(selectors.status.input).value = data.status || 'Pending';
      }
      getEl(selectors.currency.input).value = data.currency || '$';
      getEl(selectors.customCurrency).value = data.customCurrency || '';
      getEl(selectors.dateIssue.input).value = data.dateIssue || '';
      getEl(selectors.dateDue.input).value = data.dateDue || '';
      
      getEl(selectors.fromCompany.input).value = data.fromCompany || '';
      getEl(selectors.fromName.input).value = data.fromName || '';
      getEl(selectors.fromEmail.input).value = data.fromEmail || '';
      getEl(selectors.fromAddress.input).value = data.fromAddress || '';

      getEl(selectors.toCompany.input).value = data.toCompany || '';
      getEl(selectors.toName.input).value = data.toName || '';
      getEl(selectors.toEmail.input).value = data.toEmail || '';
      getEl(selectors.toAddress.input).value = data.toAddress || '';

      getEl(selectors.taxRate).value = data.taxRate ?? '';
      getEl(selectors.discountRate).value = data.discountRate ?? '';
      getEl(selectors.shippingCost).value = data.shippingCost ?? '';
      getEl(selectors.notes.input).value = data.notes || '';

      // Handle custom currency selection visibility
      if (data.currency === 'custom') {
        getEl(selectors.customCurrencyContainer)?.classList.remove('hidden');
      } else {
        getEl(selectors.customCurrencyContainer)?.classList.add('hidden');
      }

      // Display Logo
      displayLogo(data.logo || '');

      // Render lines
      const lineContainer = getEl(selectors.lineItemsContainer);
      if (lineContainer) {
        lineContainer.innerHTML = '';
        if (data.items && data.items.length > 0) {
          data.items.forEach(item => addLineItem(item.desc, item.qty, item.rate));
        } else {
          addLineItem('', 1, 0);
        }
      }

      // Refresh live preview bindings
      updateAllTextPreviews();
      updateStatusUI(data.status || 'Pending');
      calculateInvoice();

      // Initialize saved template
      const savedTemplate = data.template || localStorage.getItem(STORAGE_KEYS.TEMPLATE) || 'minimal';
      setTemplate(savedTemplate);

      // Initialize saved accent color
      const savedColor = data.accentColor || '#048c5f';
      const colorInput = getEl('input-accent-color');
      const hexSpan = getEl('accent-color-hex');
      if (colorInput) colorInput.value = savedColor;
      if (hexSpan) hexSpan.textContent = savedColor;
      applyAccentColor(savedColor);

      updateToolbarUI();
    }

    // Refresh all text inputs into live previews
    function updateAllTextPreviews() {
      const updateProp = (inputId, previewId, processFn = null) => {
        const input = getEl(inputId);
        const preview = getEl(previewId);
        if (!input || !preview) return;
        let val = input.value;
        if (processFn) val = processFn(val);
        preview.textContent = val || '-';
      };

      updateProp(selectors.invNumber.input, selectors.invNumber.preview);
      updateProp(selectors.fromCompany.input, selectors.fromCompany.preview);
      updateProp(selectors.fromName.input, selectors.fromName.preview);
      updateProp(selectors.toCompany.input, selectors.toCompany.preview);
      updateProp(selectors.toName.input, selectors.toName.preview);
      updateProp(selectors.toEmail.input, selectors.toEmail.preview);
      updateProp(selectors.toAddress.input, selectors.toAddress.preview);
      updateProp(selectors.notes.input, selectors.notes.preview);

      updateProp(selectors.dateIssue.input, selectors.dateIssue.preview, (val) => {
        if (!val) return '';
        const parts = val.split('-');
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
      });
      updateProp(selectors.dateDue.input, selectors.dateDue.preview, (val) => {
        if (!val) return '';
        const parts = val.split('-');
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
      });

      // Sender combined address block
      const address = getEl(selectors.fromAddress.input)?.value || '';
      const email = getEl(selectors.fromEmail.input)?.value || '';
      let combined = '';
      if (address) combined += address;
      if (email) combined += (combined ? '\n' : '') + email;
      const fromAddrPreview = getEl(selectors.fromAddress.preview);
      if (fromAddrPreview) fromAddrPreview.textContent = combined || '-';
    }

    // Bind textual inputs to live A4 previews
    function initTextBindings() {
      const bindProp = (inputId, previewId, processFn = null) => {
        const input = getEl(inputId);
        const preview = getEl(previewId);
        if (!input || !preview) return;

        const update = () => {
          let val = input.value;
          if (processFn) val = processFn(val);
          preview.textContent = val || '-';
        };

        input.addEventListener('keyup', update);
        input.addEventListener('change', update);
      };

      bindProp(selectors.invNumber.input, selectors.invNumber.preview);
      bindProp(selectors.fromCompany.input, selectors.fromCompany.preview);
      bindProp(selectors.fromName.input, selectors.fromName.preview);
      bindProp(selectors.toCompany.input, selectors.toCompany.preview);
      bindProp(selectors.toName.input, selectors.toName.preview);
      bindProp(selectors.toEmail.input, selectors.toEmail.preview);
      bindProp(selectors.toAddress.input, selectors.toAddress.preview);
      bindProp(selectors.notes.input, selectors.notes.preview);

      bindProp(selectors.dateIssue.input, selectors.dateIssue.preview, (val) => {
        if (!val) return '';
        const parts = val.split('-');
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
      });
      bindProp(selectors.dateDue.input, selectors.dateDue.preview, (val) => {
        if (!val) return '';
        const parts = val.split('-');
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
      });

      const updateFromAddressBlock = () => {
        const address = getEl(selectors.fromAddress.input)?.value || '';
        const email = getEl(selectors.fromEmail.input)?.value || '';
        let combined = '';
        if (address) combined += address;
        if (email) combined += (combined ? '\n' : '') + email;
        const fromAddrPreview = getEl(selectors.fromAddress.preview);
        if (fromAddrPreview) fromAddrPreview.textContent = combined || '-';
      };
      getEl(selectors.fromAddress.input)?.addEventListener('keyup', updateFromAddressBlock);
      getEl(selectors.fromAddress.input)?.addEventListener('change', updateFromAddressBlock);
      getEl(selectors.fromEmail.input)?.addEventListener('keyup', updateFromAddressBlock);
      getEl(selectors.fromEmail.input)?.addEventListener('change', updateFromAddressBlock);

      updateAllTextPreviews();
    }

    // Set up global triggers and events
    function setupEventListeners() {
      // Status selector change handler
      getEl(selectors.status.input)?.addEventListener('change', (e) => {
        updateStatusUI(e.target.value);
        saveDraft();
      });

      // Status filter tabs in modal
      document.querySelectorAll('#saved-status-filter-tabs .status-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentStatusFilter = btn.getAttribute('data-status') || 'all';
          
          // Update active styling of tabs
          document.querySelectorAll('#saved-status-filter-tabs .status-tab-btn').forEach(b => {
            if (b === btn) {
              b.className = 'status-tab-btn px-2.5 py-1 rounded-md font-bold transition cursor-pointer bg-white border border-gray-200 text-gray-800 shadow-2xs';
            } else {
              b.className = 'status-tab-btn px-2.5 py-1 rounded-md font-semibold transition cursor-pointer text-gray-500 hover:text-gray-900';
            }
          });

          renderSavedInvoicesModal(getEl(selectors.savedSearchInput)?.value || '');
        });
      });

      // Currency selectors
      getEl(selectors.currency.input)?.addEventListener('change', (e) => {
        if (e.target.value === 'custom') {
          getEl(selectors.customCurrencyContainer)?.classList.remove('hidden');
        } else {
          getEl(selectors.customCurrencyContainer)?.classList.add('hidden');
        }
        calculateInvoice();
        saveDraft();
      });

      getEl(selectors.customCurrency)?.addEventListener('keyup', () => {
        calculateInvoice();
        saveDraft();
      });

      // Add item triggers
      getEl(selectors.addLineItemBtn)?.addEventListener('click', () => {
        addLineItem('', 1, 0);
        saveDraft();
      });

      // Summary input calculation bindings
      getEl(selectors.taxRate)?.addEventListener('keyup', calculateInvoice);
      getEl(selectors.taxRate)?.addEventListener('change', calculateInvoice);
      getEl(selectors.discountRate)?.addEventListener('keyup', calculateInvoice);
      getEl(selectors.discountRate)?.addEventListener('change', calculateInvoice);
      getEl(selectors.shippingCost)?.addEventListener('keyup', calculateInvoice);
      getEl(selectors.shippingCost)?.addEventListener('change', calculateInvoice);

      // Global change monitoring for autosaves
      const formInputs = document.querySelectorAll('.no-print input, .no-print textarea, .no-print select');
      formInputs.forEach(input => {
        input.addEventListener('change', saveDraft);
        input.addEventListener('keyup', saveDraft);
      });

      // Print action triggers browser native printing
      getEl(selectors.printBtn)?.addEventListener('click', () => {
        window.print();
      });

      // Reset values back to standard empty templates
      getEl(selectors.resetBtn)?.addEventListener('click', () => {
        if (confirm("Are you sure you want to reset all current invoice inputs? This will clear the current draft.")) {
          setActiveInvoiceId(null);
          localStorage.removeItem(STORAGE_KEYS.DRAFT);
          loadInvoiceData(defaults);
          showToast('Form inputs reset.');
        }
      });

      // Toolbar Save Buttons
      getEl(selectors.btnSaveInvoice)?.addEventListener('click', () => saveCurrentInvoice(false));
      getEl(selectors.btnQuickSave)?.addEventListener('click', () => saveCurrentInvoice(false));

      // New invoice triggers
      getEl(selectors.btnNewInvoice)?.addEventListener('click', createNewBlankInvoice);
      getEl(selectors.btnModalNewInvoice)?.addEventListener('click', createNewBlankInvoice);

      // Unlink active invoice trigger
      getEl(selectors.btnUnlinkInvoice)?.addEventListener('click', unlinkActiveInvoice);

      // Modal open/close triggers
      getEl(selectors.btnOpenSavedModal)?.addEventListener('click', openSavedModal);
      getEl(selectors.btnCloseSavedModal)?.addEventListener('click', closeSavedModal);
      getEl(selectors.btnModalClose)?.addEventListener('click', closeSavedModal);
      getEl(selectors.btnClearAllSaved)?.addEventListener('click', clearAllSavedInvoices);

      // Modal backdrop click
      getEl(selectors.savedInvoicesModal)?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeSavedModal();
      });

      // Search input inside modal
      getEl(selectors.savedSearchInput)?.addEventListener('input', (e) => {
        renderSavedInvoicesModal(e.target.value);
      });

      // Escape key to close modal
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSavedModal();
      });

      // Bind template buttons
      document.querySelectorAll('.template-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const tmpl = btn.getAttribute('data-template');
          setTemplate(tmpl);
          saveDraft();
        });
      });

      // Bind Accent Color Picker
      getEl('input-accent-color')?.addEventListener('input', (e) => {
        const val = e.target.value;
        const hex = getEl('accent-color-hex');
        if (hex) hex.textContent = val;
        applyAccentColor(val);
        saveDraft();
      });
    }

    // Dynamic accent color applier
    function applyAccentColor(hex) {
      const sheet = getEl('invoice-sheet');
      if (sheet) {
        sheet.style.setProperty('--theme-primary', hex);
      }
    }

    // Template management helper
    function setTemplate(templateName) {
      const sheet = getEl('invoice-sheet');
      if (!sheet) return;
      
      // Remove all theme classes
      sheet.classList.remove('tpl-minimal', 'tpl-banner', 'tpl-grid', 'tpl-classic', 'tpl-tech');
      
      // Add selected theme class
      sheet.classList.add(`tpl-${templateName}`);
      
      // Update buttons active styling
      document.querySelectorAll('.template-btn').forEach(btn => {
        if (btn.getAttribute('data-template') === templateName) {
          btn.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-700', 'shadow-sm');
          btn.classList.remove('border-gray-200', 'bg-white', 'text-gray-700', 'hover:bg-gray-50');
        } else {
          btn.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-700', 'shadow-sm');
          btn.classList.add('border-gray-200', 'bg-white', 'text-gray-700', 'hover:bg-gray-50');
        }
      });
      
      localStorage.setItem(STORAGE_KEYS.TEMPLATE, templateName);
    }

    // Bootstrapping the generator
    setupLogoHandling();
    initTextBindings();
    loadInvoiceData();
    setupEventListeners();
  });
</script>

<style>
  @keyframes modalFadeIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .animate-modal {
    animation: modalFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

