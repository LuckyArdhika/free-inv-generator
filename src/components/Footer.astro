---
const today = new Date();
const footerBrandName = "Quinvy";
const footerBrandLink = "/";
const footerDescription = "Create professional invoices instantly for your clients. Get paid faster and automate your follow-ups using the full Quinvy automation suite.";
---

<footer class="bg-[var(--bg-color)] border-t border-theme mt-20 pt-16 pb-8 font-sans transition-colors duration-300">
	<div class="max-w-[1020px] mx-auto px-4">
		<div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-16">
			
			<!-- Brand & Newsletter -->
			<div class="md:col-span-5">
				<a href={footerBrandLink} class="flex items-center gap-2 no-underline mb-4">
					<img src="/free-invoice-generator/quinvy-logo.svg" alt={footerBrandName} class="h-8 w-auto" />
					<span class="text-2xl font-bold text-[var(--text-color)]">{footerBrandName}</span>
				</a>
				<p class="text-[var(--text-muted)] text-sm mb-6 max-w-sm leading-relaxed">
					{footerDescription}
				</p>
			</div>

			<!-- Links Columns -->
			<div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8">
				<div>
					<h3 class="text-[var(--text-color)] font-bold mb-4">Product</h3>
					<ul class="flex flex-col gap-3 text-sm">
						<li><a href="/pricing/" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Pricing</a></li>
						<li><a href="/compare-vs-others/" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Compare vs Others</a></li>
						<li><a href="/changelog/" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Changelog</a></li>
					</ul>
				</div>
				<div>
					<h3 class="text-[var(--text-color)] font-bold mb-4">Resources</h3>
					<ul class="flex flex-col gap-3 text-sm">
						<li><a href="/blog/" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Blog</a></li>
						<li><a href="/docs/" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Help Center</a></li>
					</ul>
				</div>
				<div>
					<h3 class="text-[var(--text-color)] font-bold mb-4">Company</h3>
					<ul class="flex flex-col gap-3 text-sm">
						<li><a href="/about/" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">About Us</a></li>
						<li><a href="/careers/" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Careers</a></li>
						<li><a href="/contact/" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Contact</a></li>
					</ul>
				</div>
			</div>
		</div>

		<!-- Bottom Bar -->
		<div class="pt-8 border-t border-theme flex flex-col md:flex-row justify-between items-center gap-4">
			<div class="text-[var(--text-muted)] text-sm">
				&copy; {today.getFullYear()} {footerBrandName}. All rights reserved.
			</div>
			
			<div class="flex gap-6 text-sm">
				<a href="/legal/privacy" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Privacy Policy</a>
				<a href="/legal/terms" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Terms of Service</a>
				<a href="/legal/security" class="text-[var(--text-muted)] hover:text-primary transition-colors no-underline">Security</a>
			</div>

			<div class="flex gap-4">
				<a href="https://x.com/realquinvy" target="_blank" class="text-[var(--text-muted)] hover:text-primary transition-colors" aria-label="X (formerly Twitter)">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="currentColor">
						<path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
					</svg>
				</a>
				<a href="https://instagram.com/realquinvy" target="_blank" class="text-[var(--text-muted)] hover:text-primary transition-colors" aria-label="Instagram">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="currentColor">
