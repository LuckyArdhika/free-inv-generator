# Quinvy Free Invoice Generator - Environment Variables Example
# Copy this file to .env and configure as needed.

# Optional: Set anonymous pageview tracking endpoint (e.g., https://api.quinvy.com/stats/track-view)
# When omitted or empty, tracking script is completely excluded from the build.
PUBLIC_STATS_ENDPOINT=

# Optional: Set Meta / Facebook Pixel ID (e.g., 1797917667792582)
# When omitted or empty, Meta Pixel is completely excluded from the build.
PUBLIC_FACEBOOK_PIXEL_ID=
